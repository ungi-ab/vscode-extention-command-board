{
  "name": "vscode-extention-command-board",
  "displayName": "Command Board",
  "description": "Run pnpm/npm scripts across multiple worktrees and repositories from a sidebar.",
  "version": "0.0.1",
  "publisher": "hong-woongi-ab",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ungi-ab/vscode-extention-command-board.git"
  },
  "bugs": {
    "url": "https://github.com/ungi-ab/vscode-extention-command-board/issues"
  },
  "homepage": "https://github.com/ungi-ab/vscode-extention-command-board#readme",
  "keywords": [
    "worktree",
    "git",
    "terminal",
    "monorepo",
    "task runner",
    "pnpm",
    "command board"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "シェルコマンドを実行するため、信頼済みワークスペースのみで動作します。"
    }
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "commandBoard",
          "title": "Command Board",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "commandBoard": [
        {
          "id": "commandBoard.view",
          "name": "Workspaces",
          "icon": "media/icon.svg",
          "contextualTitle": "Command Board"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "commandBoard.view",
        "contents": "ワークスペースが登録されていません。\n[ワークスペースを編集](command:commandBoard.openSettings) から `commandBoard.workspaces` に追加してください。"
      }
    ],
    "commands": [
      {
        "command": "commandBoard.runCommand",
        "title": "Run command",
        "category": "Command Board",
        "icon": "$(play)"
      },
      {
        "command": "commandBoard.stopCommand",
        "title": "Stop command",
        "category": "Command Board",
        "icon": "$(debug-stop)"
      },
      {
        "command": "commandBoard.restartCommand",
        "title": "Restart command",
        "category": "Command Board",
        "icon": "$(debug-restart)"
      },
      {
        "command": "commandBoard.refresh",
        "title": "Refresh",
        "category": "Command Board",
        "icon": "$(refresh)"
      },
      {
        "command": "commandBoard.openSettings",
        "title": "Edit workspaces",
        "category": "Command Board",
        "icon": "$(gear)"
      },
      {
        "command": "commandBoard.openWorkspaceFolder",
        "title": "Reveal in Finder",
        "category": "Command Board",
        "icon": "$(folder-opened)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "commandBoard.openSettings",
          "when": "view == commandBoard.view",
          "group": "navigation@1"
        },
        {
          "command": "commandBoard.refresh",
          "when": "view == commandBoard.view",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "commandBoard.runCommand",
          "when": "view == commandBoard.view && viewItem == command-idle",
          "group": "inline@1"
        },
        {
          "command": "commandBoard.restartCommand",
          "when": "view == commandBoard.view && viewItem == command-running",
          "group": "inline@1"
        },
        {
          "command": "commandBoard.stopCommand",
          "when": "view == commandBoard.view && viewItem == command-running",
          "group": "inline@2"
        },
        {
          "command": "commandBoard.openWorkspaceFolder",
          "when": "view == commandBoard.view && viewItem == workspace",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "commandBoard.runCommand",
          "when": "false"
        },
        {
          "command": "commandBoard.stopCommand",
          "when": "false"
        },
        {
          "command": "commandBoard.restartCommand",
          "when": "false"
        },
        {
          "command": "commandBoard.openWorkspaceFolder",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Command Board",
      "properties": {
        "commandBoard.workspaces": {
          "type": "array",
          "default": [],
          "markdownDescription": "ワークツリー / リポジトリと、その中で実行するコマンドの一覧。",
          "items": {
            "type": "object",
            "required": [
              "name",
              "path",
              "commands"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "サイドバーに表示する名前"
              },
              "path": {
                "type": "string",
                "description": "ワークツリーの絶対パス。${workspaceFolder} や ${env:HOME} も使用可"
              },
              "commands": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "command"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "description": "コマンドの表示名 (例: dev, build)"
                    },
                    "command": {
                      "type": "string",
                      "description": "実行するシェルコマンド (例: pnpm dev)"
                    },
                    "env": {
                      "type": "object",
                      "description": "追加で設定する環境変数",
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "commandBoard.reuseTerminal": {
          "type": "boolean",
          "default": true,
          "description": "true の場合、同じコマンドを実行すると既存ターミナルにフォーカスする。false の場合は毎回新規ターミナルを開く。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.4.0"
  }
}
